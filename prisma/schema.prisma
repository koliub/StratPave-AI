generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String         @id @default(cuid())
  email            String         @unique
  passwordHash     String?
  name             String?
  image            String?
  createdAt        DateTime       @default(now())
  activeAiProvider String?
  accounts         Account[]
  sessions         Session[]
  ownedProjects    Project[]      @relation("OwnedProjects")
  sharedProjects   ProjectShare[]
  aiCredentials    AiCredential[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Project {
  id             String         @id @default(cuid())
  ownerId        String
  owner          User           @relation("OwnedProjects", fields: [ownerId], references: [id], onDelete: Cascade)
  projectTitle   String
  prompt         String
  nodes          Json
  edges          Json
  totalNodes     Int            @default(0)
  completedNodes Int            @default(0)
  isPublic       Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  shares         ProjectShare[]
}

model ProjectShare {
  id        String  @id @default(cuid())
  projectId String
  userId    String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model AiCredential {
  id       String  @id @default(cuid())
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider String
  apiKey   String
  model    String?
  baseUrl  String?

  @@unique([userId, provider])
}
